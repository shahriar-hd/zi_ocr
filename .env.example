# Environment for the Persian PaddleOCR-VL LoRA pipeline.
#
# Copy to `.env` and fill in what your machine needs:
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is committed, so keep it free of real
# secrets. Every variable here is optional - each falls back to
# `configs/synth_config.yaml` or to a documented default. Precedence is:
#
#     CLI flag  >  environment  >  YAML  >  dataclass default
#
# A variable already exported in your shell wins over the value here, so a
# deployment's real environment is never silently overridden by a checked-out
# file.

# ---------------------------------------------------------------------------
# Config file
# ---------------------------------------------------------------------------

# Which YAML the pipeline loads when `--config` is not passed.
FA_OCR_CONFIG=

# ---------------------------------------------------------------------------
# Corpus paths
# ---------------------------------------------------------------------------

# Re-anchors every asset path that the YAML puts under the repository's own
# `data/` tree. With FA_OCR_DATA_DIR=/mnt/corpus, the YAML's
# `data/text/generator.csv` is read from `/mnt/corpus/text/generator.csv`.
# Use this on a training host where the corpus lives on a mounted volume;
# paths the YAML points elsewhere are left alone.
FA_OCR_DATA_DIR=

# Individual overrides, each replacing one `paths` entry. These beat
# FA_OCR_DATA_DIR, so the narrower setting wins. Relative values resolve
# against the repository root, exactly as in the YAML.
FA_OCR_MANIFEST=
FA_OCR_PLAINTEXT_DIR=
FA_OCR_LOGOS_DIR=
FA_OCR_SIGNATURES_DIR=
FA_OCR_TEXTURE_DIR=
FA_OCR_OUTPUT_DIR=

# Where the Persian font files live. Unlike the paths above this is a host
# directory, not corpus data, so it is used exactly as written.
FA_OCR_FONTS_DIR=

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------

# Master seed. The same seed reproduces the same pages, so change it to
# generate a different corpus rather than to fix a bad sample.
FA_OCR_SEED=

# Where `--hugging-face` writes its Parquet shards and dataset card.
FA_OCR_HF_OUTPUT_DIR=

# Split shares for the export, written as `train=0.9,test=0.1`. Shares must sum
# to 1.0 and every name must be train, validation or test.
#
# The YAML is the right home for these: assignment is a hash of each letter's
# source id, so different shares re-deal the whole corpus. Use this variable for
# a throwaway export - one split for a quick smoke test - not for the dataset
# you publish.
FA_OCR_HF_SPLITS=

# Where the export is published: the Hub dataset repository, as `owner/name`.
# The owner is your HuggingFace username or an organisation you can write to, and
# the repository is created on first upload if it does not exist. Per-person, so
# it belongs here rather than in the committed YAML.
FA_OCR_HF_REPO_ID=

# Whether a repository created by an upload starts private (`true`/`false`,
# default false). Ignored for a repository that already exists - change that in
# the Hub's settings instead.
FA_OCR_HF_PRIVATE=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# NVIDIA NIM key(s) for the text stage (`text_generator.py`). Several keys may
# share one variable, separated by commas or whitespace, and the generator
# rotates through them; numbered variants NVIDIA_API_KEY_1, _2, ... also work.
NVIDIA_API_KEY=

# Google Drive OAuth for `scripts/upload_to_drive.py`. CREDENTIALS is the
# client secret you download from the Cloud console; TOKEN is where the script
# caches the authorised session. Both default under `secrets/`.
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_TOKEN=

# HuggingFace token, used by `--hf-upload` and by
# `scripts/upload_to_hugging_face.py`. Needs **write** scope; make one at
# https://huggingface.co/settings/tokens. HUGGING_FACE_HUB_TOKEN and
# HUGGINGFACEHUB_API_TOKEN are accepted too, and if none is set the uploader
# falls back to the cache `huggingface-cli login` writes. The token is only ever
# read from the environment - never from a config file, never from an argument -
# and is never logged.
HF_TOKEN=
